RobustViews::unrecognized - tree rendering (view def GeneralView)

part def Loops::A
  part b
part def Loops::B
  part a
part def Cycles::C
connection def DerivationConnections::Derivation
  requirement originalRequirement
  requirement derivedRequirements
  assert constraint originalNotDerived
  assert constraint originalImpliesDerived

relationships:
  Loops::A *-- Loops::B: b
  Loops::B *-- Loops::A: a
