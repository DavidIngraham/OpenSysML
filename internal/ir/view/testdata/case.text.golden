CaseExamples::caseDiagram - case rendering (render asCaseDiagram)

use case CaseExamples::'Provide Transportation'
subject vehicle
actor driver
objective (Transport the vehicle and its passengers safely.)
use case def CaseExamples::'Add Fuel'
subject vehicle
actor fueler
include use case 'enter vehicle'
subject vehicle
actor driver
use case 'Drive Vehicle'
subject vehicle
actor driver
analysis def CaseExamples::FuelAnalysis
subject vehicle
objective (Estimate the fuel remaining after a journey.)
verification def CaseExamples::FuelVerification
subject vehicle
objective

relationships:
  CaseExamples::'Provide Transportation' -- vehicle: «subject»
  driver -- CaseExamples::'Provide Transportation'
  CaseExamples::'Provide Transportation' .. objective n3
  CaseExamples::'Add Fuel' -- vehicle: «subject»
  fueler -- CaseExamples::'Add Fuel'
  CaseExamples::'Provide Transportation' ..> CaseExamples::'Add Fuel': «include»
  CaseExamples::'Provide Transportation' ..> 'enter vehicle': «include»
  'enter vehicle' -- vehicle: «subject»
  driver -- 'enter vehicle'
  CaseExamples::'Provide Transportation' *-- 'Drive Vehicle'
  'Drive Vehicle' -- vehicle: «subject»
  driver -- 'Drive Vehicle'
  CaseExamples::FuelAnalysis -- vehicle: «subject»
  CaseExamples::FuelAnalysis .. objective n15
  CaseExamples::FuelVerification -- vehicle: «subject»
