{
  "scenarios": [
    {
      "id": "render_view_artifact/text",
      "description": "Formatted text source is returned alongside structured view data.",
      "rpc": "RenderView",
      "requires_capabilities": [
        "render_view",
        "render_view_artifact"
      ],
      "expect_without_capability": {
        "status": "UNIMPLEMENTED",
        "status_message_contains": "render_view"
      },
      "model": {
        "fixture": "views.sysml"
      },
      "request": {
        "model_hash": "${model_hash}",
        "view": "RenderViewDemo::connections",
        "artifact": {
          "form": "text"
        }
      },
      "expect": {
        "non_empty": [
          "artifact.text"
        ],
        "contains_all": {
          "artifact.form": [
            "text"
          ],
          "artifact.media_type": [
            "charset=utf-8"
          ]
        }
      }
    },
